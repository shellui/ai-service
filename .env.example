# ai-service settings. Full reference: docs/configuration.md
# Shellui local stack: docs/devstack.md
# Generated from config/env_registry.py: python manage.py generate_env --example > .env.example
# Production: python manage.py generate_env --host ai.example.com
# Copy to .env for local runs. Commented-out lines show the default the code uses.

# Required
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
IDENTITY_SERVICE_URL=http://localhost:8001
IDENTITY_JWKS_URL=http://localhost:8001/.well-known/jwks.json

# Required when DEBUG=false (production)
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
REDIS_URL=
CSRF_TRUSTED_ORIGINS=

# Optional (defaults shown)

# Runtime
# LOG_LEVEL=INFO
# SETUP_TOKEN=
# DJANGO_ADMIN_ENABLED=true

# Docker Compose host port
# AI_SERVICE_PORT=8006

# Database
# SQLITE_PATH=db.sqlite3
# POSTGRES_SSL_REQUIRE=true

# Pin identity JWKS in production.
# IDENTITY_JWKS_FILE=
# IDENTITY_JWKS=
# IDENTITY_JWKS_URL=
# JWKS_CACHE_TTL=900
# JWKS_TIMEOUT=15
# JWKS_RETRIES=2
# JWT_ALGORITHMS=RS256
# JWT_HS256_FALLBACK_SECRET=
# ALLOW_JWT_HS256_FALLBACK=false

# RS256 delegation to identity
# AI_SERVICE_SIGNING_KEY_FILE=

# Downstream MCP origins
# STORAGE_SERVICE_URL=
# HOSTING_SERVICE_URL=
# EMAIL_SERVICE_URL=https://email.shellui.com
# EMAIL_SERVICE_API_KEY=
# EMAIL_SERVICE_ALLOW_PRIVATE=false
# SAAS_SERVICE_URL=

# Public origins for downstream MCP token resources, when the URLs above are internal
# STORAGE_SERVICE_PUBLIC_URL=
# HOSTING_SERVICE_PUBLIC_URL=
# EMAIL_SERVICE_PUBLIC_URL=
# SAAS_SERVICE_PUBLIC_URL=

# Public origin of this gateway; the MCP URL is /c/<company_id>/mcp
# AI_PUBLIC_URL=

# Aggregated MCP gateway
# MCP_GATEWAY_TOOLS_CACHE_TTL_SECONDS=30

# tools/list default: discovery or all
# MCP_TOOLS_LIST_MODE=discovery
# MCP_GATEWAY_DOWNSTREAM_TIMEOUT_SECONDS=5

# Max exp-iat on signed approval assertions to identity (setup flows need 600–900s)
# MCP_APPROVAL_ASSERTION_MAX_LIFETIME_SECONDS=900

# Setup session Allow lower bound (signed claims)
# MCP_APPROVAL_SETUP_SESSION_TTL_MIN_SECONDS=600

# Setup session Allow upper bound (signed claims)
# MCP_APPROVAL_SETUP_SESSION_TTL_MAX_SECONDS=900
# MCP_APPROVAL_CHANNEL_BY_COMPANY=
# MCP_RATE_LIMIT_AGENT=120

# CORS and HTTPS
# CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOW_PRIVATE_NETWORK=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Sentry
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEP_ALIVE=75
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=200
