{
  "name": "storage-service-frontend",
  "private": true,
  "description": "Tailwind CSS build for storage-service landing templates",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/site.css --minify && node -e \"const fs=require('fs');const p='static/css/site.css';let b=fs.readFileSync(p);while(b.length&&(b[b.length-1]===0x0a||b[b.length-1]===0x0d))b=b.subarray(0,-1);fs.writeFileSync(p,Buffer.concat([b,Buffer.from('\\n')]))\"",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./static/css/site.css --watch",
    "dev:css": "npm run watch:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
